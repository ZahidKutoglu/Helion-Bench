# Helion Bench — Engineering Intelligence Platform
# Copy this file to .env and adjust values for your machine.
# Never commit a real .env file. Never put API keys in source code.

# --- Application ---
APP_NAME=Helion Bench
APP_VERSION=0.2.0
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local fallback (no Docker):
DATABASE_URL=sqlite+aiosqlite:///../data/helion.db
# Postgres when Compose is running:
# DATABASE_URL=postgresql+asyncpg://helion:helion@localhost:5432/helion_bench
DB_POOL_SIZE=5
DB_ECHO=false

# --- Qdrant ---
# auto: try the Docker URL, then fall back to embedded on-disk Qdrant.
QDRANT_MODE=auto
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=../data/qdrant
QDRANT_TIMEOUT_SECONDS=5

# --- LLM / embeddings ---
# "dev" is a labeled deterministic fallback. It is not a neural model.
LLM_PROVIDER=dev
EMBEDDING_PROVIDER=dev
# Optional OpenAI-compatible API. If unset, the dev responder is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

MAX_UPLOAD_BYTES=2000000
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=160

VITE_API_BASE_URL=
